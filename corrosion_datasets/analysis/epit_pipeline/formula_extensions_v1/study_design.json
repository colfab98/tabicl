  "feature_definitions": {
    "Cr": "Cr (wt.%)",
    "Mo": "Mo (wt.%)",
    "W": "W (wt.%)",
    "N": "N (wt.%)",
    "Ni": "Ni (wt.%)",
    "C": "C (wt.%)",
    "Mn": "Mn (wt.%)",
    "S": "S (wt.%)",
    "Cu": "Cu (wt.%)",
    "Nb": "Nb (wt.%)",
    "Si": "Si (wt.%)",
    "PREN": "Cr + 3.3*(Mo + 0.5*W) + 16*N",
    "log_PREN": "log(1 + PREN)",
    "log_Mo": "log(1 + Mo)",
    "log_W": "log(1 + W)",
    "Ni_fraction": "Ni / max(Fe + Ni, 1e-8)",
    "Cr_MoW_synergy": "sqrt(Cr*(Mo + 0.5*W))",
    "MnS": "sqrt(Mn*S)",
    "temperature": "CP_temp (deg C)",
    "log_chloride": "log10(max(CP_Cl [mol/L], 1e-6))",
    "pH": "CP_pH",
    "acidic_pH": "max(7 - CP_pH, 0)",
    "temperature_chloride": "(CP_temp - 25)*log10(max(CP_Cl, 1e-6))",
    "PREN_chloride": "PREN*log10(max(CP_Cl, 1e-6))",
    "MoN_acidity": "sqrt(Mo*N)*max(7 - CP_pH, 0)",
    "log_scan": "log10(scan_rate); nonpositive/missing stays unknown",
    "log_area": "log10(Test_area_cm2); nonpositive/missing stays unknown",
    "log_grit": "log10(Prep_grinding_grit); nonpositive/missing stays unknown",
    "log_exposure": "log10(CP_time); nonpositive/missing stays unknown",
    "log_prep_time": "log10(Prep_time); nonpositive/missing stays unknown",
    "log_heat_hours": "log10(heat_treatment_duration_h); nonpositive/missing stays unknown",
    "scan_chloride": "log_scan*log_chloride",
    "heat_temperature": "heat_treatment_temperature_C",
    "thermal_window": "exp(-((heat_temperature-700)/200)^2)*log(1+heat_hours); exploratory basis, not a calibrated kinetic law",
    "carbon_thermal_window": "C*thermal_window",
    "phase_BCC": "reported phase_BCC; unknown is not absence",
    "log_H2SO4_mol_L": "log10(H2SO4_mol_L); no inferred zeros or unit conversion",
    "log_HCl_mol_L": "log10(HCl_mol_L); no inferred zeros or unit conversion",
    "log_NaCl_mol_L": "log10(NaCl_mol_L); no inferred zeros or unit conversion",
    "log_Na2SO4_mol_L": "log10(Na2SO4_mol_L); no inferred zeros or unit conversion",
    "log_CP_Br": "log10(CP_Br); no inferred zeros or unit conversion",

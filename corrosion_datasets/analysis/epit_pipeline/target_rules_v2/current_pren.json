  "formula": {
    "applicability": "all alloy classes",
    "environment_formula": "standardize(0.075*z(temperature) + 0.925*z(log10(chloride)) + 0.115*z(abs(pH-7.25)))",
    "fixed_internal_environment_weights": [
      0.075,
      0.925,
      0.115
    ],
    "fixed_internal_material_weights": [
      1.0,
      0.25,
      3.3,
      1.65
    ],
    "fixed_ph_neutral": 7.25,
    "interaction_formula": "sigmoid(-z(material))*sigmoid(z(log10(chloride)))",
    "material_formula": "Cr + 0.25*Ni + 3.3*Mo + 1.65*W",
    "process_effect": "excluded from calibration because the current synthetic rule samples random method offsets for every task",
    "signed_terms": [
      "+material_passivity",
      "-environment_aggressiveness",
      "-material_chloride_interaction"
    ]
  },

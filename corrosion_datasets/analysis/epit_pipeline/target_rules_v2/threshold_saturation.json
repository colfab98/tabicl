  "formula": {
    "additional_interaction": "-sigmoid(z(temperature))*sigmoid(z(log10(chloride)))",
    "applicability": "Fe Alloy, NiCrMo Alloy",
    "environment_formula": "standardize(0.075*z(temperature) + 0.925*z(log10(chloride)) + 0.115*z(abs(pH-7.25)))",
    "fixed_direct_evaluation_parameters": {
      "Cr_slope_wt_percent": 2.0,
      "Cr_threshold_wt_percent": 12.0,
      "MoW_saturation_scale_wt_percent": 1.0
    },
    "fixed_internal_environment_weights": [
      0.075,
      0.925,
      0.115
    ],
    "fixed_internal_material_weights": [
      1.0,
      0.0,
      3.25,
      1.7875
    ],
    "fixed_ph_neutral": 7.25,
    "interaction_formula": "sigmoid(-z(material))*sigmoid(z(log10(chloride)))",
    "material_formula": "sigmoid((Cr-12)/2) + log1p((Mo + 0.55*W)/1.0)",
    "process_effect": "excluded from calibration because the current synthetic rule samples random method offsets for every task",
    "removed_terms": [
      "Ni contribution",
      "Gaussian noise on unrelated minor-element weights"
    ],
    "signed_terms": [
      "+material_passivity",
      "-environment_aggressiveness",
      "-material_chloride_interaction",
      "-temperature_chloride_interaction"
    ],
    "synthetic_parameter_ranges": {
      "a_M": [
        2.5,
        4.0
      ],
      "eta_W": [
        0.3,
        0.8
      ]
    },
    "synthetic_use": "threshold, slope and saturation scale vary once per synthetic task around these centers"
  },

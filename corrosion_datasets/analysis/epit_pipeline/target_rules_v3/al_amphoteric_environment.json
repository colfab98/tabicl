  "formula": {
    "applicability": "Al Alloy",
    "environment_formula": "-log10(max(chloride, 1e-12)); -max(temperature_C - 30, 0); -max(5 - pH, 0); -max(pH - 9, 0)",
    "fixed_direct_evaluation_parameters": {
      "acidic_ph_threshold": 5.0,
      "alkaline_ph_threshold": 9.0,
      "chloride_floor_M": 1e-12,
      "temperature_threshold_C": 30.0
    },
    "hypothesis_limit": "The separate acidic and alkaline penalties are exploratory. Published pH effects depend on the solution regime, and one kinetic study found pH-independent pitting potential at fixed chloride over its studied range.",
    "literature_basis": [
      {
        "claim": "Al pitting potential varies approximately linearly with log chloride at fixed pH.",
        "doi": "10.1016/0010-938X(94)00150-5"
      },
      {
        "claim": "Al pitting potential decreases with temperature, with a stronger change above about 30 C.",
        "doi": "10.1016/j.corsci.2010.09.046"
      },
      {
        "claim": "Al activation/passivation depends jointly on potential, pH, and chloride.",
        "doi": "10.1016/0010-938X(78)90054-9"
      }
    ],
    "synthetic_use": "direct-evaluation candidate only; no Al synthetic routing"
  },

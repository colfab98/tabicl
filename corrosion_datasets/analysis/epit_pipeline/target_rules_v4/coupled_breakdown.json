  "formula": {
    "applicability": "Fe Alloy, NiCrMo Alloy",
    "coupled_breakdown_formula": "-sigmoid(0.65*z(log10(chloride)) + 0.25*z(high_temperature) + 0.10*z(joint_environment) - 0.75*z(material))",
